dashboards/**/dist/
dashboards/**/dist-server/
dashboards/**/daemon/

# Logs
dashboards/**/*.log

# Artefactos, datos generados y binarios de instalación
*.zip
*.csv
*.msi
dashboards/**/nssm.exe

# Miscelánea
*.user
.DS_Store
Thumbs.db

# Copiá este archivo como .env y completá los valores.
# .env NO va al repositorio.

PORT=3016
HOST=127.0.0.1

# ── SQL Server (10.0.0.115) ─────────────────────────────────────────────────
DB_SERVER=10.0.0.115
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=
DB_ENCRYPT=0
DB_TRUST_CERT=1
DB_POOL_MAX=6
DB_TIMEOUT_MS=60000

# Bases: TABLEROS (GrillaVentasComparativas, ya cerrada por mes) y
# dw_vallejo (f_objetivos/l_sucursal, para el mes en curso todavía sin cerrar).
DB_DATABASE_TABLEROS=TABLEROS
DB_DATABASE_DWVALLEJO=dw_vallejo

# Primer AñoMes (AAAAMM) que se muestra en los pivots.
ANIOMES_DESDE=201401

TTL_CERRADO_MIN=720
TTL_ABIERTO_MIN=5

# Copiá este archivo como .env y completá los valores.
# .env NO va al repositorio.

# ── HTTP ──────────────────────────────────────────────────────────────────
PORT=3000

# ── SQL Server ────────────────────────────────────────────────────────────
# Server real (10.0.0.115): SQL Server 2008 R2, sin TLS → DB_ENCRYPT=0
DB_SERVER=10.0.0.115
DB_DATABASE=dw_vallejo
DB_PORT=1433

# Autenticación SQL (lo habitual). Usá una cuenta de sólo lectura.
DB_USER=tablero_ro
DB_PASSWORD=

# Autenticación integrada de Windows: dejá DB_USER vacío y completá estos tres
# DB_DOMAIN=VALENET
# DB_WIN_USER=svc_tablero
# DB_WIN_PASSWORD=

# 1 = TLS. El server real (2008 R2) no lo soporta bien: usar 0.
DB_ENCRYPT=0
DB_TRUST_CERT=1

DB_POOL_MAX=6
DB_TIMEOUT_MS=120000

# ── Tablas (ver consultas.js para el detalle de cada mapeo) ────────────────
# Tres bases del mismo server: TABLEROS (ventas reales + encargados),
# db_Cegid (nombres/provincia de sucursal), dw_vallejo (objetivos, días
# hábiles, y el puente cod_sucursal↔id_sucursal). Los defaults de
# consultas.js ya apuntan bien — sólo pisar si cambia el esquema real.
# TBL_VENTAS=TABLEROS.dbo.GRILLAQV
# TBL_OBJETIVOS=dbo.f_objetivos
# TBL_DIAS_HAB=dbo.f_dias_habiles
# TBL_SUCURSAL=db_Cegid.dbo.Sucursales
# TBL_PUENTE_ID=dw_vallejo.dbo.l_sucursal
# EncargadosSucursalObjetivos: el filtro exacto (NombreApellido con más de 2
# filas, sin "Administrador") es el que usa el propio script QENCARGADOS del
# .qvw — ver consultas.js.
# TBL_ENCARGADOS=TABLEROS.dbo.EncargadosSucursalObjetivos

# ── Alcance y caché ───────────────────────────────────────────────────────
# Primer año que se carga. El tablero necesita el año anterior completo para
# poder calcular el día equivalente.
ANIO_DESDE=2024

# Un mes cerrado no cambia más; el mes en curso sí.
TTL_MES_CERRADO_MIN=720
TTL_MES_ABIERTO_MIN=5

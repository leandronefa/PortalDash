{
  "name": "tablero-objetivos-sucursal",
  "version": "1.0.0",
  "private": true,
  "description": "Tablero Objetivos Sucursal — port web del .qvw de QlikView, con API contra SQL Server",
  "type": "commonjs",
  "main": "server.js",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "salud": "node -e \"fetch('http://localhost:'+(process.env.PORT||3000)+'/api/salud').then(r=>r.json()).then(o=>{console.log(o);process.exit(o.ok?0:1)}).catch(e=>{console.error(e.message);process.exit(1)})\""
  },
  "dependencies": {
    "compression": "^1.7.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mssql": "^11.0.1"
  }
}

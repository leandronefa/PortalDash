<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DashboardPortal</RootNamespace>
    <AssemblyName>DashboardPortal</AssemblyName>
    <UserSecretsId>dashboard-portal-secrets</UserSecretsId>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Conector SQL Server via ODBC (evita SNI nativo de SqlClient roto por Windows Updates) -->
    <PackageReference Include="System.Data.Odbc" Version="9.0.0" />

    <!-- Permite ejecutar la app como Servicio de Windows -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="9.0.0" />

    <!-- Base de datos propia de la aplicacion (SQLite por defecto / SQL Server opcional) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.0" />

    <!-- Proxy inverso hacia los dashboards Node (IHttpForwarder) -->
    <PackageReference Include="Yarp.ReverseProxy" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Garantiza que la carpeta de datos se publique -->
    <Folder Include="App_Data\" />
  </ItemGroup>

</Project>

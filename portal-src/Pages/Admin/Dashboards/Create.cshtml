@page
@model DashboardPortal.Pages.Admin.Dashboards.CreateModel
@{
    ViewData["Title"] = "Nuevo dashboard";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Nuevo dashboard</h1>
        <p class="page-subtitle">La URL se genera automáticamente a partir del host y el puerto.</p>
    </div>
    <a href="/Admin/Dashboards" class="btn btn-outline">Volver</a>
</div>

<div class="panel form-panel">
    <form method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="form-group">
            <label class="label" asp-for="Input.Name"></label>
            <input class="input" asp-for="Input.Name" maxlength="120" required placeholder="Ej.: Dashboard Ventas" />
            <span class="field-error" asp-validation-for="Input.Name"></span>
        </div>

        <div class="form-group">
            <label class="label" asp-for="Input.Description"></label>
            <textarea class="textarea" asp-for="Input.Description" rows="3" maxlength="500" placeholder="Breve descripción del tablero"></textarea>
            <span class="field-error" asp-validation-for="Input.Description"></span>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label class="label" asp-for="Input.Port"></label>
                <input class="input" asp-for="Input.Port" type="number" min="1" max="65535" required />
                <span class="field-error" asp-validation-for="Input.Port"></span>
            </div>
            <div class="form-group">
                <label class="label" asp-for="Input.Host"></label>
                <input class="input" asp-for="Input.Host" placeholder="Vacío = host del portal" />
                <span class="hint">Solo si el dashboard vive en otro servidor.</span>
            </div>
        </div>

        <div class="form-group">
            <label class="label" asp-for="Input.UrlOverride"></label>
            <input class="input" asp-for="Input.UrlOverride" placeholder="http://servidor:puerto (opcional, anula host+puerto)" />
            <span class="hint">Déjelo vacío para usar la URL generada automáticamente.</span>
        </div>

        <div class="form-group">
            <label class="label">Icono</label>
            <div class="icon-picker">
                @foreach (var opt in Model.Icons)
                {
                    <label class="icon-option">
                        <input type="radio" asp-for="Input.Icon" value="@opt.Key" />
                        <span class="icon-glyph">@Html.Raw(IconLibrary.Render(opt.Key, 22))</span>
                        <span class="icon-name">@opt.Label</span>
                    </label>
                }
            </div>
        </div>

        <div class="form-group">
            <label class="checkbox">
                <input type="checkbox" asp-for="Input.IsActive" />
                <span>Activo (visible en el catálogo)</span>
            </label>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Crear dashboard</button>
            <a href="/Admin/Dashboards" class="btn btn-ghost">Cancelar</a>
        </div>
    </form>
</div>

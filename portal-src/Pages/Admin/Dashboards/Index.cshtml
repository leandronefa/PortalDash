@page
@model DashboardPortal.Pages.Admin.Dashboards.IndexModel
@{
    ViewData["Title"] = "Dashboards";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Dashboards</h1>
        <p class="page-subtitle">Administre los tableros publicados y su estado.</p>
    </div>
    <a href="/Admin/Dashboards/Create" class="btn btn-primary">+ Nuevo dashboard</a>
</div>

@if (Model.Rows.Count == 0)
{
    <div class="empty-state">
        <div class="empty-icon">@Html.Raw(IconLibrary.Render("layers", 36))</div>
        <h2>No hay dashboards</h2>
        <p>Cree el primer dashboard para que aparezca en el catálogo.</p>
        <a href="/Admin/Dashboards/Create" class="btn btn-primary">Crear dashboard</a>
    </div>
}
else
{
    <div class="panel">
        <div class="table-wrap">
            <table class="table">
                <thead>
                    <tr>
                        <th style="width:48px;"></th>
                        <th>Nombre</th>
                        <th>Puerto</th>
                        <th>URL</th>
                        <th>Estado</th>
                        <th>Creado</th>
                        <th class="actions-col">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        var d = row.Dashboard;
                        <tr>
                            <td><span class="table-icon">@Html.Raw(IconLibrary.Render(d.Icon, 20))</span></td>
                            <td>
                                <div class="cell-strong">@d.Name</div>
                                <div class="muted small">@(string.IsNullOrWhiteSpace(d.Description) ? "—" : d.Description)</div>
                            </td>
                            <td><code>@d.Port</code></td>
                            <td><a href="@row.Url" target="_blank" rel="noopener" class="link">@row.Url</a></td>
                            <td>
                                @if (d.IsActive)
                                {
                                    <span class="badge badge-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge badge-muted">Inactivo</span>
                                }
                            </td>
                            <td class="nowrap muted">@d.CreatedAt.ToString("dd/MM/yyyy")</td>
                            <td class="actions-col">
                                <div class="row-actions">
                                    <a href="/Admin/Dashboards/Edit?id=@d.Id" class="btn btn-sm btn-outline">Editar</a>
                                    <form method="post" asp-page-handler="Toggle" class="inline-form">
                                        <input type="hidden" name="id" value="@d.Id" />
                                        <input type="hidden" name="active" value="@((!d.IsActive).ToString().ToLower())" />
                                        <button type="submit" class="btn btn-sm btn-ghost">
                                            @(d.IsActive ? "Desactivar" : "Activar")
                                        </button>
                                    </form>
                                    <a href="/Admin/Dashboards/Delete?id=@d.Id" class="btn btn-sm btn-danger-outline">Eliminar</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

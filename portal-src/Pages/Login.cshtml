@page
@model LoginModel
@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "Iniciar sesión";
}

<div class="login-card">
    <div class="login-logo">@Html.Raw(IconLibrary.Render("dashboard", 32))</div>
    <h1 class="login-title">Bienvenido</h1>
    <p class="login-sub">Inicie sesión para acceder a sus dashboards</p>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-error" role="alert">@Model.ErrorMessage</div>
    }

    <form method="post" autocomplete="on" novalidate>
        <input type="hidden" asp-for="ReturnUrl" />

        <div class="form-group">
            <label class="label" asp-for="Input.Username"></label>
            <input class="input" asp-for="Input.Username" autocomplete="username" autofocus required />
            <span class="field-error" asp-validation-for="Input.Username"></span>
        </div>

        <div class="form-group">
            <label class="label" asp-for="Input.Password"></label>
            <input class="input" asp-for="Input.Password" type="password" autocomplete="current-password" required />
            <span class="field-error" asp-validation-for="Input.Password"></span>
        </div>

        <button type="submit" class="btn btn-primary btn-block">Ingresar</button>
    </form>
</div>

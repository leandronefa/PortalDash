@page
@model ViewModel
@{
    ViewData["Title"] = Model.Dashboard?.Name ?? "Dashboard";
}

<div class="viewer">
    <div class="viewer-bar">
        <a href="/" class="btn btn-outline btn-sm viewer-back">
            @Html.Raw(IconLibrary.Render("trend", 16))
            <span>Volver al catálogo</span>
        </a>

        <div class="viewer-title">
            <span class="viewer-title-icon">@Html.Raw(IconLibrary.Render(Model.Dashboard?.Icon, 18))</span>
            <span>@Model.Dashboard?.Name</span>
        </div>

        <div class="viewer-actions">
            <a href="@Model.DashboardUrl" target="_blank" rel="noopener" class="btn btn-ghost btn-sm" title="Abrir en pestaña nueva">
                @Html.Raw(IconLibrary.Render("globe", 16))
                <span class="hide-sm">Abrir aparte</span>
            </a>
        </div>
    </div>

    <div class="viewer-frame-wrap">
        <iframe class="viewer-frame"
                src="@Model.DashboardUrl"
                title="@Model.Dashboard?.Name"
                referrerpolicy="no-referrer"
                allow="fullscreen"
                loading="eager"></iframe>
    </div>
</div>
